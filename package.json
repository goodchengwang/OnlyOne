{
  "name": "onlyone",
  "private": true,
  "type": "module",
  "bin": {
    "onlyone": "src/cli.ts"
  },
  "scripts": {
    "dev": "bash scripts/prepare-dev-runtime.sh && NSH_RUNTIME=\"$PWD/.nsh/dev-runtime\" nsh run app",
    "deploy:cloud": "bun cloud/deploy.ts",
    "daemon": "bun src/cli.ts daemon",
    "tick": "bun src/cli.ts tick",
    "status": "bun src/cli.ts status",
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "package:npm": "bun scripts/package-npm.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
