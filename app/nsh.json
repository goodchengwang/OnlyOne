{
  "name": "OnlyOne",
  "id": "dev.onlyone.app",
  "version": "0.1.0",
  "build": 1,
  "appearance": "system",
  "theme": "theme.json",
  "web": {
    "host": "./host.js"
  },
  "capabilities": {
    "process": {
      "execute": ["/bin/sh", "cmd.exe", "powershell.exe"],
      "env": ["APPDATA", "ProgramFiles", "USERPROFILE", "ONLYONE_HOME", "ONLYONE_DATA_DIR", "ONLYONE_CONF", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"]
    },
    "clipboard": true,
    "statusBar": true,
    "network": {
      "hosts": [
        "*"
      ]
    },
    "host": [
      "page",
      "pushState",
      "pushEnable",
      "pushDisable",
      "setSession",
      "setBadge",
      "clearNotifications",
      "vibrate",
      "speechState",
      "speechStart",
      "speechStop",
      "speechAbort"
    ],
    "picker": true,
    "speech": true,
    "notifications": true,
    "fs": {
      "read": [
        "${homeDir}"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "mailto"
      ]
    }
  },
  "icon": "icon.png",
  "updater": {
    "github": "goodchengwang/OnlyOne",
    "publicKey": "6tDnb1j73Ae9sKMx0XYQmEXa+zdiiYYAN7MicRcGN+U=",
    "packages": {
      "roots": [
        "yQB5SrgJaufMrxr4i8ibtqIpLinMEURAqNsF0RdavAM="
      ]
    }
  }
}
